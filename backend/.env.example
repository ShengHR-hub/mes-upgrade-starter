# ===== 服务 =====
# 后端端口：契约约定 NestJS 监听 3001（Vue 同源代理将 /api/v1 转发至此）
NODE_ENV=development
PORT=3001

# ===== 数据库（MySQL841 / 127.0.0.1:3306）=====
# 本机共存 5 个 MySQL 实例，必须显式指定 host/port，不要依赖默认值
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
# ⚠️ 凭据不落盘（2026-10-10 统一口径）：口令**不写在此文件**，改由进程环境变量按会话注入：
#   pwsh 7：$env:DB_PASSWORD = "<口令>"; npm run start:dev
#   bash  ：DB_PASSWORD="<口令>" npm run start:dev
DB_PASSWORD=
DB_DATABASE=smart_mes
DB_CHARSET=utf8mb4
DB_TIMEZONE=+08:00

# 注意：synchronize 已在代码中写死为 false（表结构由 db/schema.sql 冻结），
# 不提供任何环境变量开关；误设 DB_SYNCHRONIZE 会导致启动直接报错退出。
DB_LOGGING=false
DB_CONNECT_TIMEOUT=10000
